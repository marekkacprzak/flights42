{
  "name": "flights42",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "ai-server": "mastra dev --dir ai-server/src/mastra",
    "ai-server:build": "mastra build --dir ai-server/src/mastra",
    "ai-server:start": "mastra start --dir ai-server/src/mastra",
    "ai-cs-server": "dotnet run --project ai-cs-server --urls http://127.0.0.1:3011",
    "ai-cs-server:start": "dotnet run --project ai-cs-server --urls http://127.0.0.1:3011",
    "ai-cs-bff": "tsx watch ai-cs-bff/src/server.ts",
    "ai-cs-bff:start": "tsx ai-cs-bff/src/server.ts",
    "ai-cs-mcp-server": "dotnet run --project ai-cs-mcp-server --urls http://127.0.0.1:3002",
    "mcp-server": "concurrently \"npm run mcp-server:app:watch\" \"tsx watch mcp-server/src/server.ts\"",
    "mcp-server:app:build": "vite build --config mcp-server/vite.config.ts",
    "mcp-server:app:watch": "vite build --config mcp-server/vite.config.ts --watch",
    "mcp-server:start": "npm run mcp-server:app:build && tsx mcp-server/src/server.ts",
    "agent": "npm run ai-server",
    "agent:build": "npm run ai-server:build",
    "agent:start": "npm run ai-server:start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:aimock": "ng run flights:test-node",
    "lint": "ng lint",
    "format": "prettier --write \"**/*.{ts,html,scss,css,json,md}\"",
    "ag-ui-simple:client": "node --import tsx ag-ui-simple/index.ts",
    "ag-ui-simple:client-tools": "node --import tsx ag-ui-simple/with-tools.ts",
    "ai-demo-server": "mastra dev --dir ai-demo/server",
    "ai-demo-client": "node --watch --import tsx ai-demo/client/index.ts",
    "ai-cs-demo-server": "dotnet run --project ai-cs-demo/server --urls http://localhost:4555",
    "ai-cs-demo-client": "node --watch --import tsx ai-cs-demo/client/index.ts",
    "simple-client": "ng serve simple-client",
    "mcp-apps-demo": "vite --config mcp-apps-demo/vite.config.ts --open /host.html",
    "mcp-apps-demo:build": "vite build --config mcp-apps-demo/vite.config.ts",
    "voice-demo": "vite voice-demo",
    "prepare": "husky",
    "ai-cs": "concurrently \"pnpm ai-cs-server\" \"pnpm ai-cs-bff\"",
    "aspire-dashboard": "docker run --rm -it -p 18888:18888 -p 4317:18889 --name aspire-dashboard mcr.microsoft.com/dotnet/aspire-dashboard:latest",
    "ai-cs-aspire": "ASPIRE_ALLOW_UNSECURED_TRANSPORT=true dotnet run --project ai-cs-aspire/AppHost --launch-profile http"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "overrides": {
    "rxjs": "$rxjs",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@softarc/detective": {
      "express": "^4.21.2",
      "path-to-regexp": "^0.1.12",
      "cookie": "^0.7.2",
      "qs": "^6.15.2"
    }
  },
  "dependencies": {
    "@a2ui/angular": "^0.10.4",
    "@a2ui/web_core": "^0.10.5",
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/mastra": "1.0.0",
    "@ag-ui/mcp-apps-middleware": "0.0.3",
    "@ai-sdk/openai": "^3.0.49",
    "@angular-architects/native-federation": "^21.1.0",
    "@angular-architects/ngrx-toolkit": "^21.0.1",
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@copilotkit/angular": "0.3.0",
    "@copilotkit/core": "^1.70.1",
    "@mastra/client-js": "^1.11.2",
    "@mastra/core": "^1.24.1",
    "@mastra/libsql": "^1.7.3",
    "@mastra/loggers": "^1.0.4",
    "@mastra/mcp": "^1.4.1",
    "@mastra/memory": "^1.13.0",
    "@mastra/observability": "^1.7.3",
    "@modelcontextprotocol/ext-apps": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/signals": "^21.0.1",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "hono": "^4.12.26",
    "jsonata": "^2.1.0",
    "marked": "^17.0.1",
    "ngx-markdown": "^21.0.1",
    "quickjs-emscripten": "^0.32.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.16",
    "@angular/cli": "^21.2.16",
    "@angular/compiler-cli": "^21.2.17",
    "@commitlint/config-conventional": "^20.2.0",
    "@copilotkit/aimock": "^1.37.4",
    "@softarc/detective": "^2.0.2",
    "@softarc/eslint-plugin-sheriff": "^0.19.6",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "21.1.0",
    "commitlint": "^20.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.7",
    "mastra": "^1.5.0",
    "ng-packagr": "^21.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.47.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.0.8"
  }
}
